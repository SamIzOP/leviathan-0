{
  "name": "leviathan-0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client \"npm run dev -w @leviathan/server\" \"npm run dev -w @leviathan/client\"",
    "build": "npm run typecheck && npm run build -w @leviathan/client && npm run build -w @leviathan/server",
    "start": "node --env-file-if-exists=.env packages/server/dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint . && prettier --check . && npm run typecheck",
    "format": "prettier --write .",
    "bots": "tsx scripts/bots.ts",
    "test:browser": "tsx scripts/browser-test.ts",
    "level:check": "tsx scripts/level-check.ts",
    "level:map": "tsx scripts/level-map.ts",
    "level:collision-audit": "tsx scripts/collision-audit.ts",
    "level:layout-check": "tsx scripts/layout-check.ts",
    "assets:check": "tsx scripts/assets-check.ts",
    "assets:fetch": "tsx tools/assets/fetch.ts tools/assets/lists/foundry-row.json",
    "assets:optimize": "tsx tools/assets/optimize.ts tools/assets/lists/foundry-row.json",
    "assets:pipeline": "npm run assets:fetch && npm run assets:optimize",
    "forge:export": "tsx scripts/forge-export.ts",
    "movement:harness": "tsx scripts/movement-harness.ts",
    "movement:perf": "tsx scripts/movement-perf.ts",
    "test:boundary": "tsx scripts/boundary-test.ts",
    "test:movement": "tsx scripts/movement-browser.ts",
    "dressing:capture": "tsx scripts/dressing-capture.ts",
    "dressing:report": "tsx scripts/dressing-report.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/node": "^22.0.0",
    "@types/three": "^0.180.0",
    "@types/ws": "^8.18.0",
    "concurrently": "^9.2.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.0",
    "fflate": "^0.8.3",
    "globals": "^16.4.0",
    "meshoptimizer": "^1.3.0",
    "playwright": "^1.56.0",
    "prettier": "^3.6.0",
    "sharp": "^0.35.5",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vitest": "^4.1.12"
  }
}

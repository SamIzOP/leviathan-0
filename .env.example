# Optional: defaults work without copying this file. Put local overrides in .env.
# One HTTP + WebSocket port. Hosting providers supply PORT automatically.
PORT=3000
# Single gate for solo entry, F4/backtick panel and legacy F8/F9 controls.
# npm run dev defaults ON; npm start defaults OFF. No .env is required.
# Explicit false disables development tools; explicit true enables them in either mode.
# DEV_TOOLS=true
# Fixed simulation steps/second (10–120) and snapshots/second (1–60).
TICK_RATE=60
SNAPSHOT_RATE=30
# Match, countdown and voting windows, in milliseconds.
MATCH_MS=300000
COUNTDOWN_MS=5000
VOTE_MS=20000
# Disconnected slot retention and empty room lifetime, in milliseconds.
RECONNECT_MS=45000
EMPTY_ROOM_MS=60000
# Static bundle path, relative to the process working directory.
CLIENT_DIST=packages/client/dist
# Runtime mode (development or production).
NODE_ENV=development
# Test harness only: URL of the running server and optional browser executable.
# TEST_URL=http://localhost:3000
# CHROMIUM_PATH=C:/path/to/chrome.exe
